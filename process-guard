#!/usr/bin/env python3
"""Alert when a long-running process is stuck.

A process matches only when all of these are true:
- Its start time is at least 15 minutes ago.
- It is using a high share of one CPU, or a high GPU compute share.
  GPU memory and process memory do not count.
- An output file named in its command has not changed.
  The file mtime is at least 10 minutes old, and a second look confirms it.

The alert is one HTTP POST to https://ntfy.sh/thatIsalert.
The body is the pid and nothing else.

Each run records one sample and exits. A timer runs it every 5 minutes.
"""

from __future__ import annotations

import os
import stat
import sys
import time
import subprocess
import urllib.request
import urllib.error
from pathlib import Path

HZ = os.sysconf("SC_CLK_TCK")
LONG_SECONDS = 15 * 60
STALE_SECONDS = 10 * 60
HOT_CPU = 0.85
HOT_GPU = 50
NTFY_URL = "https://ntfy.sh/thatIsalert"

HOME = Path.home()
STATE_DIR = HOME / ".local/state/process-guard"
ALLOW_PATH = HOME / ".config/process-guard/allowlist"
LOG_PATH = STATE_DIR / "guard.log"
STATE_PATH = STATE_DIR / "state.v2.tsv"

OUTPUT_FLAGS = {"-o", "--output", "--outfile", "--out", "-out"}
INPUT_FLAGS = {"-i", "--input", "--input-file"}
SOURCE_EXT = {
    ".py", ".sh", ".bash", ".js", ".ts", ".c", ".cc", ".cpp", ".h",
    ".rs", ".go", ".rb", ".pl", ".java", ".so",
}

DEFAULT_ALLOW = """\
# One name per line. A match on the process name or the command skips that process.
tensorfold
"""


def log(msg: str) -> None:
    stamp = time.strftime("%F %T")
    with LOG_PATH.open("a") as handle:
        handle.write(f"{stamp} {msg}\n")


def ensure_files() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    ALLOW_PATH.parent.mkdir(parents=True, exist_ok=True)
    if not ALLOW_PATH.exists():
        ALLOW_PATH.write_text(DEFAULT_ALLOW)


def allowlist() -> list[str]:
    names = []
    for raw in ALLOW_PATH.read_text().splitlines():
        line = raw.split("#", 1)[0].strip()
        if line:
            names.append(line)
    return names


def allowed(comm: str, cmdline: str, names: list[str]) -> bool:
    for name in names:
        if comm == name or name in cmdline:
            return True
    return False


def boot_time() -> float:
    for line in Path("/proc/stat").read_text().splitlines():
        if line.startswith("btime "):
            return float(line.split()[1])
    return time.time()


def read_proc(pid: int) -> dict | None:
    try:
        raw = Path(f"/proc/{pid}/stat").read_text()
        cmdline_b = Path(f"/proc/{pid}/cmdline").read_bytes()
    except (FileNotFoundError, ProcessLookupError, PermissionError):
        return None
    left = raw.find("(")
    right = raw.rfind(")")
    if left < 0 or right < left:
        return None
    rest = raw[right + 2 :].split()
    if len(rest) < 20:
        return None
    args = [part.decode("utf-8", "replace") for part in cmdline_b.split(b"\0") if part]
    return {
        "pid": pid,
        "comm": raw[left + 1 : right],
        "state": rest[0],
        "ticks": int(rest[11]) + int(rest[12]),
        "start": int(rest[19]),
        "args": args,
        "cmdline": " ".join(args),
    }


def output_args(args: list[str]) -> list[str]:
    """Return output paths named in the command. Inputs after -i are skipped."""
    found: list[str] = []
    positional: list[str] = []
    index = 0
    while index < len(args):
        arg = args[index]
        if arg in INPUT_FLAGS and index + 1 < len(args):
            index += 2
            continue
        if arg in OUTPUT_FLAGS and index + 1 < len(args):
            found.append(args[index + 1])
            index += 2
            continue
        if arg.startswith("--output="):
            found.append(arg.split("=", 1)[1])
            index += 1
            continue
        if arg.startswith("-") and arg != "-":
            index += 1
            continue
        positional.append(arg)
        index += 1
    if not found and len(positional) >= 2:
        last = positional[-1]
        suffix = Path(last).suffix.lower()
        if ("/" in last or suffix) and suffix not in SOURCE_EXT:
            found.append(last)
    return found


def proc_cwd(pid: int) -> Path:
    try:
        return Path(os.readlink(f"/proc/{pid}/cwd"))
    except OSError:
        return Path("/")


def resolve_output(cwd: Path, raw: str) -> Path:
    path = Path(raw)
    if not path.is_absolute():
        path = cwd / path
    return path


def file_signature(path: Path) -> tuple | None:
    """Return a signature, or None when the path does not exist."""
    try:
        info = path.stat()
    except (FileNotFoundError, PermissionError):
        return None
    if stat.S_ISDIR(info.st_mode):
        newest = info.st_mtime_ns
        count = 0
        try:
            for child in path.iterdir():
                count += 1
                try:
                    newest = max(newest, child.stat().st_mtime_ns)
                except OSError:
                    pass
        except OSError:
            pass
        return ("dir", count, newest)
    return ("file", info.st_size, info.st_mtime_ns)


def signature_age(sig: tuple | None, now: float) -> float | None:
    if sig is None:
        return None
    return now - (sig[2] / 1e9)


def gpu_sm() -> dict[int, int]:
    """Map pid to GPU SM percent. The memory column is ignored."""
    try:
        result = subprocess.run(
            ["nvidia-smi", "pmon", "-c", "1"],
            capture_output=True,
            text=True,
            timeout=8,
            check=False,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return {}
    usage: dict[int, int] = {}
    for line in result.stdout.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) < 4:
            continue
        try:
            pid = int(parts[1])
        except ValueError:
            continue
        sm = parts[3]
        if sm == "-":
            continue
        try:
            usage[pid] = int(sm)
        except ValueError:
            continue
    return usage


def load_state_full() -> dict:
    state: dict = {}
    if not STATE_PATH.exists():
        return state
    for line in STATE_PATH.read_text().splitlines():
        parts = line.split("\t")
        if len(parts) != 6:
            continue
        key, ticks, wall, sig, stale, alert = parts
        state[key] = {
            "ticks": int(ticks) if ticks else 0,
            "wall": float(wall) if wall else 0.0,
            "sig": sig,
            "stale": float(stale) if stale else None,
            "alert": float(alert) if alert else 0.0,
        }
    return state


def save_state(state: dict) -> None:
    lines = []
    for key, row in state.items():
        stale = "" if row["stale"] is None else str(row["stale"])
        alert = "" if not row["alert"] else str(row["alert"])
        lines.append(
            f"{key}\t{row['ticks']}\t{row['wall']}\t{row['sig']}\t{stale}\t{alert}"
        )
    text = "\n".join(lines)
    if text:
        text += "\n"
    tmp = STATE_PATH.with_suffix(".tmp")
    tmp.write_text(text)
    tmp.replace(STATE_PATH)


def sig_text(sig: tuple | None) -> str:
    if sig is None:
        return "missing"
    return f"{sig[0]}:{sig[1]}:{sig[2]}"


def scan(state: dict, names: list[str], now: float, gpu: dict[int, int], started: float) -> list[tuple[str, int]]:
    self_pid = os.getpid()
    seen: set[str] = set()
    alerts: list[tuple[str, int]] = []
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        pid = int(name)
        if pid == self_pid:
            continue
        info = read_proc(pid)
        if info is None or not info["args"]:
            continue
        if allowed(info["comm"], info["cmdline"], names):
            continue
        key = f"{pid}:{info['start']}"
        seen.add(key)
        prev = state.get(key)
        age = now - (started + info["start"] / HZ)
        frac = 0.0
        if prev is not None:
            dt = now - prev["wall"]
            if dt > 0:
                frac = ((info["ticks"] - prev["ticks"]) / HZ) / dt
        hot = frac >= HOT_CPU or gpu.get(pid, 0) >= HOT_GPU
        outputs = [
            resolve_output(proc_cwd(pid), raw) for raw in output_args(info["args"])
        ]
        sig = tuple(file_signature(path) for path in outputs)
        text = "|".join(sig_text(item) for item in sig)
        same = prev is not None and prev["sig"] == text
        row = {
            "ticks": info["ticks"],
            "wall": now,
            "sig": text,
            "stale": prev["stale"] if same else now,
            "alert": prev["alert"] if same else 0.0,
        }
        if same and hot and outputs and age >= LONG_SECONDS and not row["alert"]:
            unchanged = True
            for item in sig:
                if item is None:
                    if row["stale"] is None or now - row["stale"] < STALE_SECONDS:
                        unchanged = False
                else:
                    age_s = signature_age(item, now)
                    if age_s is None or age_s < STALE_SECONDS:
                        unchanged = False
            if unchanged:
                alerts.append((key, pid))
        state[key] = row
    for key in list(state):
        if key not in seen:
            del state[key]
    return alerts


def post_pid(pid: int) -> bool:
    body = str(pid).encode("ascii")
    request = urllib.request.Request(NTFY_URL, data=body, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            ok = 200 <= response.status < 300
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        log(f"ntfy fail {pid} {exc}")
        return False
    log(f"ntfy ok {pid}" if ok else f"ntfy fail {pid} status")
    return ok


def self_test() -> None:
    ffmpeg = [
        "ffmpeg", "-y", "-i", "/tmp/picture.mp4", "-i", "/tmp/sound.mp3",
        "/tmp/out/golden.mp4",
    ]
    assert output_args(ffmpeg) == ["/tmp/out/golden.mp4"]
    flagged = ["encoder", "-i", "/tmp/in.wav", "-o", "/tmp/out.wav"]
    assert output_args(flagged) == ["/tmp/out.wav"]
    script = ["python3", "/tmp/train.py"]
    assert output_args(script) == []
    print("self-test ok")


def main() -> None:
    if "--self-test" in sys.argv:
        self_test()
        return
    ensure_files()
    dry = "--once" in sys.argv
    now = time.time()
    state = load_state_full()
    alerts = scan(state, allowlist(), now, gpu_sm(), boot_time())
    if dry:
        print("alerts=" + ",".join(str(pid) for _key, pid in alerts))
    else:
        for key, pid in alerts:
            if post_pid(pid):
                state[key]["alert"] = now
    save_state(state)


if __name__ == "__main__":
    main()
